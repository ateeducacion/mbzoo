{
  "name": "mbzoo-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run test:coverage && bun run build && bun run research:validate",
    "test": "bun test packages apps fixtures",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage packages apps fixtures",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "dev:viewer": "bun run --filter '@mbzoo/viewer' dev",
    "build:viewer": "bun run --filter '@mbzoo/viewer' build",
    "docs:dev": "bun run --filter '@mbzoo/docs' dev",
    "docs:build": "bun run --filter '@mbzoo/docs' build",
    "preview:viewer": "bun run --filter '@mbzoo/viewer' preview",
    "cli": "bun run --filter '@mbzoo/cli' start --",
    "test:e2e": "playwright test",
    "research:indexes": "bun run research/tools/generate-indexes.ts",
    "research:validate": "bun run research/tools/validate-research.ts && bun run research:indexes -- --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@zip.js/zip.js": "2.8.59",
    "fflate": "0.8.3",
    "typescript": "7.0.2"
  }
}
